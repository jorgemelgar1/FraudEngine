{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubo Fraud Engine",
  "version": "0.1.1",
  "identifier": "com.cubopago.fraud-engine",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cubo Fraud Engine",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/fraud-engine-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English", "Spanish"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cubo-fraud-engine"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/jorgemelgar1/FraudEngine/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMEUyMTVGN0U4OERBNDIKUldSQzJvaCtYeUVPd0ZRMkE2VVJtYjdpb1lVVFpoQ2RWQ3VmcXhzajVtVFBmMThld3hwNHdxTmUK"
    }
  }
}

# Copy this file to `.env.local` (next to it) and fill in real values.
# `.env.local` is gitignored so the actual values never get committed.
#
# These three values are the SAME ones used by the Vercel app — copy them
# from the root `.env.local`. The desktop app uses the `VITE_` prefix
# because Vite (the bundler) only exposes vars to client code if they
# start with that.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_ALLOWED_EMAIL_DOMAIN=cubopago.com

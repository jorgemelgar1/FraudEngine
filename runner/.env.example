# Runner configuration — copy to runner/.env and fill in.
#
#   cp runner/.env.example runner/.env
#
# runner/.env is gitignored and must stay that way. This repository is
# PUBLIC: the code is fine to publish, a map of which internal host serves
# which endpoint is not.
#
# Every value below is a placeholder. Get the real ones from your browser's
# network tab while using the CMS (F12 → Network → Copy as cURL), which is
# also how they were discovered in the first place.


# ── Cubo CMS API ─────────────────────────────────────────────────────────
# Scheme + host of the API the CMS front-end calls. No trailing slash.
CUBO_API_ROOT=https://api.example.internal

# Report endpoint path. {country_id} is substituted per request.
# Returns 200 with an empty body and mails the CSV — fire-and-forget.
CUBO_REPORT_PATH=/api/vN/<path>/{country_id}/<resource>/report

# Endpoint listing countries, used to confirm the id → name mapping.
CUBO_COUNTRIES_PATH=/api/vN/countries

# Origin and Referer are replayed because the API may check them.
CUBO_ORIGIN=https://cms.example.internal
CUBO_REFERER=https://cms.example.internal/


# ── Report email ─────────────────────────────────────────────────────────
# Who the report mail comes from, and its subject. Every report mail is
# identical — no country, no date range — so these identify the TYPE of
# mail only. Which country a CSV belongs to is read from the file itself.
CUBO_REPORT_SENDER=reports@example.internal
CUBO_REPORT_SUBJECT=<exact subject line, including any typos in it>

# OPTIONAL. If you filter report mail into a Gmail label, naming it here
# narrows the search to that label instead of the whole mailbox.
#
# Leave it BLANK unless the label already exists in Gmail. A label that does
# not exist matches nothing, and the only symptom is the runner reporting
# zero emails found - with nothing pointing at the label as the reason.
CUBO_REPORT_LABEL=

# Regex matching the CSV link in the email body.
# ⚠ That link is UNAUTHENTICATED — possession of the URL is authorization.
#   It is never logged and never appears in an exception message.
CUBO_CSV_URL_PATTERN=https://cdn\.example\.internal/[a-z/]+/[0-9a-fA-F-]{36}\.csv

# Host used by the mail provider's click tracking. The runner prefers the
# direct link from the plain-text part, so it neither depends on this
# service nor registers phantom "clicks".
CUBO_TRACKING_HOST=links.example.internal


# ── Gmail (OAuth) ────────────────────────────────────────────────────────
# From a Google Cloud OAuth client of type "Desktop app".
#
# Neither value is really secret — a desktop client ships both inside the
# distributed binary, which is why the flow uses PKCE — but they still stay
# out of this repository.
#
# The REFRESH TOKEN is a real credential and is deliberately NOT here: it is
# stored beside the CMS token (DPAPI on Windows, a 0600 file on Linux) by
#   python3 runner/gmail.py --authorize
#
# Publish the OAuth app as "In production". While it is in "Testing", Google
# expires refresh tokens after 7 days and the runner stops working every week
# for no visible reason.
GMAIL_CLIENT_ID=<client id>.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=<client secret>


# ── Supabase ─────────────────────────────────────────────────────────────
# Same project the web app and desktop app use. The service-role key is
# acceptable here because the runner lives on one trusted machine — it must
# never be bundled into the distributed desktop app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Attributed as the author of automated runs, so /historial can tell them
# apart from a person's manual upload.
RUNNER_EMAIL=runner@example.com


# ── Schedule ─────────────────────────────────────────────────────────────
# Days of lookback. 1 means "today + yesterday": ~25 hours of data at 01:00,
# ~47 at 23:00. Always at least the 24 hours the engine's longest detector
# window needs.
RUNNER_LOOKBACK_DAYS=1

# How long to wait for a report email before giving up on that slot. The
# runner does NOT re-trigger on timeout — that would queue duplicate
# reports. It waits for the country's next slot instead.
RUNNER_EMAIL_TIMEOUT=900
RUNNER_EMAIL_POLL=30

# Override where state and transient CSVs live. Defaults to the
# platform-appropriate directory (%LOCALAPPDATA% / $XDG_DATA_HOME).
# RUNNER_STATE_DIR=


# ── Slack ────────────────────────────────────────────────────────────────
# Optional. With nothing set here the runner works exactly as before, just
# without announcing anything — notifications are an enhancement, not a
# dependency, so a missing webhook must never stop fraud detection.
#
# This URL is a CREDENTIAL: whoever holds it can post into the channel.
# Treat it like the report CDN link. Never commit it, never paste it into a
# chat or a ticket.
#
# Your CTO's snippet probably looks like:
#
#   curl -X POST -H 'Content-type: application/json' \
#     --data '{"text":"Hello, World!"}' \
#     https://hooks.slack.com/services/T0000/B0000/XXXXXXXXXXXXXXXXXXXXXXXX
#
# Copy ONLY the URL — the last argument. No quotes, no trailing slash.
#
# Renaming the Slack channel does NOT break this: the webhook is bound to
# the channel's internal id, not its name. Archiving or deleting the
# channel, removing the Slack app, or converting the channel from public to
# private all CAN break it, and show up as a 404 or 403 in the run log.
#
# Verify it with:  python3 runner/cycle.py --slack-test
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional per-country overrides. Different ops people watch different
# countries, so one channel each is the likely end state; when that happens,
# set these and leave the code alone. Anything unset falls back to
# SLACK_WEBHOOK_URL above.
# SLACK_WEBHOOK_URL_SV=
# SLACK_WEBHOOK_URL_PA=
# SLACK_WEBHOOK_URL_GT=

# What to do with new Monitor-tier merchants.
#   summary  (default) one collapsed line: "3 merchants nuevos: A, B, C"
#   off                omit them; Critical findings are never affected
SLACK_MONITOR=summary

# Consecutive cycles a country must fail before the channel hears about it.
# Not 1: the overlapping analysis windows absorb a single miss, and alerting
# on every miss is how a channel gets muted. The alert fires once, on the
# cycle that reaches this number, and re-arms after a success.
SLACK_FAILURE_STREAK=3

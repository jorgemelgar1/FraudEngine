# Runner configuration — copy to runner/.env and fill in.
#
#   cp runner/.env.example runner/.env
#
# runner/.env is gitignored and must stay that way. This repository is
# PUBLIC: the code is fine to publish, a map of which internal host serves
# which endpoint is not.
#
# Every value below is a placeholder. Get the real ones from your browser's
# network tab while using the CMS (F12 → Network → Copy as cURL), which is
# also how they were discovered in the first place.


# ── Cubo CMS API ─────────────────────────────────────────────────────────
# Scheme + host of the API the CMS front-end calls. No trailing slash.
CUBO_API_ROOT=https://api.example.internal

# Report endpoint path. {country_id} is substituted per request.
# Returns 200 with an empty body and mails the CSV — fire-and-forget.
CUBO_REPORT_PATH=/api/vN/<path>/{country_id}/<resource>/report

# Endpoint listing countries, used to confirm the id → name mapping.
CUBO_COUNTRIES_PATH=/api/vN/countries

# Origin and Referer are replayed because the API may check them.
CUBO_ORIGIN=https://cms.example.internal
CUBO_REFERER=https://cms.example.internal/


# ── Report email ─────────────────────────────────────────────────────────
# Who the report mail comes from, and its subject. Every report mail is
# identical — no country, no date range — so these identify the TYPE of
# mail only. Which country a CSV belongs to is read from the file itself.
CUBO_REPORT_SENDER=reports@example.internal
CUBO_REPORT_SUBJECT=<exact subject line, including any typos in it>

# Gmail label the report mail is filtered into, so the runner polls a small
# labelled set instead of searching the whole mailbox.
CUBO_REPORT_LABEL=cubo-reports

# Regex matching the CSV link in the email body.
# ⚠ That link is UNAUTHENTICATED — possession of the URL is authorization.
#   It is never logged and never appears in an exception message.
CUBO_CSV_URL_PATTERN=https://cdn\.example\.internal/[a-z/]+/[0-9a-fA-F-]{36}\.csv

# Host used by the mail provider's click tracking. The runner prefers the
# direct link from the plain-text part, so it neither depends on this
# service nor registers phantom "clicks".
CUBO_TRACKING_HOST=links.example.internal


# ── Supabase ─────────────────────────────────────────────────────────────
# Same project the web app and desktop app use. The service-role key is
# acceptable here because the runner lives on one trusted machine — it must
# never be bundled into the distributed desktop app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Attributed as the author of automated runs, so /historial can tell them
# apart from a person's manual upload.
RUNNER_EMAIL=runner@example.com


# ── Schedule ─────────────────────────────────────────────────────────────
# Days of lookback. 1 means "today + yesterday": ~25 hours of data at 01:00,
# ~47 at 23:00. Always at least the 24 hours the engine's longest detector
# window needs.
RUNNER_LOOKBACK_DAYS=1

# How long to wait for a report email before giving up on that slot. The
# runner does NOT re-trigger on timeout — that would queue duplicate
# reports. It waits for the country's next slot instead.
RUNNER_EMAIL_TIMEOUT=900
RUNNER_EMAIL_POLL=30

# Override where state and transient CSVs live. Defaults to the
# platform-appropriate directory (%LOCALAPPDATA% / $XDG_DATA_HOME).
# RUNNER_STATE_DIR=

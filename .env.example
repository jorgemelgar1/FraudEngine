# Copy this file to .env.local for local development.
# In Vercel, set these as Environment Variables in your project settings.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Email domain that can sign in (defense-in-depth check inside the function
# AND the middleware AND the OAuth callback)
ALLOWED_EMAIL_DOMAIN=cubopago.com

# Same value, but exposed to the browser so the Google OAuth account picker
# pre-filters to this domain on the login screen. Optional — falls back to
# cubopago.com if unset. Set this if you change ALLOWED_EMAIL_DOMAIN above.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=cubopago.com
